+			else:
+				outer.append(outer_full[i])
+		# Altitudes par sommet : bord de chaussée, dessus du trottoir, sol sous le bord extérieur.
+		var edge_y := PackedFloat32Array()
+		var top_y := PackedFloat32Array()

+func _lamp_spacing(kind: String) -> float:
+	match kind:
+		"trunk", "primary":
+			return 36.0
+		"secondary":
+			return 40.0
+		"tertiary":
+			return 52.0
+		"residential", "unclassified":
+			return 70.0
